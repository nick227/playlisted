# Database (Railway MySQL plugin sets DATABASE_URL automatically)
DATABASE_URL="mysql://root:@localhost:3306/playlisted"

# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
TRUST_PROXY=1
# ENABLE_API_DOCS=1

# Same-origin API when the SPA is served by this process (leave empty on Railway monolith)
VITE_API_BASE_URL=

# Optional split-origin deploy (web on another host)
# CORS_ORIGIN=https://your-frontend.example.com

# Uploads (mount a Railway volume at this path for persistent media)
UPLOADS_DIR=uploads
MEDIA_BASE_URL=/uploads
IMAGE_MAX_DIMENSION=1920
OPTIMIZED_IMAGE_MAX_BYTES=5242880

# Seed (local/dev only; do not enable on production unless intentional)
SEED_DATA_PATH=prisma/seed-data.json
