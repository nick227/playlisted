# Database (Railway MySQL plugin sets DATABASE_URL automatically)
DATABASE_URL="mysql://root:@localhost:3306/playlisted"

# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
TRUST_PROXY=1
# Canonical public site URL for share previews and absolute OG image URLs
# PUBLIC_SITE_URL=https://playlisted.com
# ENABLE_API_DOCS=1

# Same-origin API when the SPA is served by this process (leave empty on Railway monolith)
VITE_API_BASE_URL=

# Optional split-origin deploy (web on another host)
# CORS_ORIGIN=https://your-frontend.example.com

# Uploads (mount a Railway volume at this path for persistent media)
UPLOADS_DIR=uploads
MEDIA_BASE_URL=/uploads
IMAGE_MAX_DIMENSION=1920
OPTIMIZED_IMAGE_MAX_BYTES=5242880

# Optional shared object storage for Railway split services.
# When enabled, new uploads are copied to Cloudflare R2 and stored as public URLs.
# STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET_NAME=...
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL=https://<public-bucket-host>
# UPLOADS_PUBLIC_BASE_URL=https://<public-bucket-host>

# Subtitles
# API/web service safe default: rows can queue, but this process does not run inference.
SUBTITLES_ENABLED=true
SUBTITLES_PROVIDER=disabled
SUBTITLES_MAX_AUDIO_SECONDS=900
SUBTITLES_WORKER_SLEEP_MS=10000
SUBTITLES_WHISPER_MODEL=tiny
SUBTITLES_VAD_FILTER=true
# Manual backfill apply guard. Do not set globally; set only on the one command invocation.
# SUBTITLES_BACKFILL_CONFIRM=QUEUE_SUBTITLES
# Local RTX dev:
# SUBTITLES_PROVIDER=local-python
# SUBTITLES_DEVICE=cuda
# SUBTITLES_COMPUTE_TYPE=float16
# SUBTITLES_WHISPER_MODEL=small
# Railway subtitle worker service with Modal, fail-closed unless all are set:
# SUBTITLES_PROVIDER=modal
# SUBTITLES_WORKER_REQUIRE_MODAL=true
# SUBTITLES_WORKER_SLEEP_MS=5000
# SUBTITLES_MODAL_ENABLED=true
# SUBTITLES_MODAL_DAILY_MAX_JOBS=3
# SUBTITLES_MODAL_MONTHLY_BUDGET_CENTS=300
# SUBTITLES_MODAL_MAX_AUDIO_SECONDS=900
# MODAL_SUBTITLES_URL=https://...
# MODAL_SUBTITLES_TOKEN=change-me

# Seed (local/dev only; do not enable on production unless intentional)
SEED_DATA_PATH=prisma/seed-data.json
