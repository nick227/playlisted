{
  "name": "playlisted-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Playlisted backend with Prisma, OpenAPI-first REST API, and generated client SDK.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run upload-policy:build && tsc -p tsconfig.json",
    "upload-policy:build": "npm --prefix packages/upload-policy run build",
    "build:prod": "npm run upload-policy:build && prisma generate && npm run build && npm run web:build",
    "start": "node dist/server.js",
    "start:prod": "node dist/server.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev --skip-generate",
    "prisma:migrate:deploy": "node scripts/railway-predeploy.mjs",
    "prisma:baseline": "node scripts/prisma-baseline.mjs",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:file": "tsx prisma/seed.ts",
    "prisma:backfill-duration": "tsx prisma/seed/backfillDuration.ts",
    "prisma:backfill-subtitles": "tsx prisma/seed/backfillSubtitles.ts",
    "prisma:cleanup-orphan-recordings": "tsx prisma/seed/cleanupOrphanRecordings.ts",
    "subtitles:maintenance": "tsx scripts/subtitle-maintenance.ts",
    "subtitles:worker": "node dist/workers/subtitleWorker.js",
    "subtitles:worker:prod": "npm run subtitles:worker",
    "subtitles:worker:dev": "tsx src/workers/subtitleWorker.ts",
    "subtitles:worker:once": "tsx src/workers/subtitleWorker.ts --once",
    "subtitles:worker:prod-local-once": "tsx scripts/run-prod-local-subtitle-worker.ts",
    "subtitles:worker:prod-local": "tsx scripts/run-prod-local-subtitle-worker.ts",
    "subtitles:status": "tsx scripts/subtitles-status.ts",
    "openapi:validate": "swagger-cli validate openapi/openapi.yaml",
    "openapi:types": "openapi-typescript openapi/openapi.yaml -o packages/client-sdk/src/generated/schema.ts",
    "openapi:check": "npm run openapi:types && git diff --exit-code packages/client-sdk/src/generated/schema.ts",
    "sdk:build": "npm run openapi:types && npm --prefix packages/client-sdk run build",
    "check": "npm run prisma:validate && npm run openapi:validate && npm run build",
    "ci": "npm run check && npm run web:build",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm run sdk:build && npm --prefix apps/web run build && npm run web:budget",
    "web:budget": "node scripts/check-web-budget.mjs",
    "perf:assets": "node scripts/check-web-budget.mjs",
    "perf:http": "node scripts/benchmark-http.mjs",
    "perf:pages": "node scripts/benchmark-pages.mjs",
    "perf:pages:strict": "node scripts/benchmark-pages.mjs --strict",
    "perf:ci": "npm run web:build && npm run perf:assets -- --strict",
    "uploads:images:scan": "node scripts/optimize-upload-images.mjs",
    "uploads:images:optimize": "node scripts/optimize-upload-images.mjs --write",
    "ports:free": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/free-ports.ps1",
    "dev:full": "npm run ports:free && npx concurrently -k -n api,web -c blue,green \"npm run dev\" \"npm run web:dev\"",
    "dev:wsl": "npx concurrently -k -n api,web,worker -c blue,green,magenta \"SERVE_WEB_DIST=1 npm run dev\" \"npm run web:dev\" \"npm run subtitles:worker:dev\"",
    "dev:wsl:no-worker": "npx concurrently -k -n api,web -c blue,green \"SERVE_WEB_DIST=1 npm run dev\" \"npm run web:dev\"",
    "dev:worker": "npm run subtitles:worker",
    "test": "npm run upload-policy:build && vitest run",
    "test:watch": "vitest",
    "test:api": "vitest run src/__tests__/apiKeys.test.ts src/__tests__/ingestUploads.test.ts src/__tests__/ingestPlaylists.test.ts src/__tests__/ingestRecordings.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/lib-storage": "^3.1075.0",
    "@playlisted/upload-policy": "*",
    "@prisma/client": "^6.8.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-openapi-validator": "^5.5.8",
    "express-rate-limit": "^8.5.2",
    "multer": "^2.1.1",
    "music-metadata": "^11.12.3",
    "openai": "^6.45.0",
    "prisma": "^6.8.2",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.15.30",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "openapi-typescript": "^7.8.0",
    "playwright": "^1.60.0",
    "supertest": "^7.2.2",
    "swagger-cli": "^4.0.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.7"
  }
}
